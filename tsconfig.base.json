{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@chatapp/ui/*": ["packages/ui/src/*"],
      "@chatapp/types/*": ["packages/types/src/*"],
      "@chatapp/config/*": ["packages/config/src/*"]
    }
  }
}
