{
  "name": "chatApp",
  "version": "1.0.0",
  "private": true,
  "description": "chatApp monorepo",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "corepack pnpm --parallel --filter \"./apps/*\" run build",
    "lint": "corepack pnpm --parallel --filter \"./apps/*\" run lint",
    "test": "corepack pnpm --parallel --filter \"./apps/*\" run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install",
    "db:migrate": "corepack pnpm --filter api run prisma:migrate",
    "db:seed": "corepack pnpm --filter api run prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "eslint": "^9.11.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
